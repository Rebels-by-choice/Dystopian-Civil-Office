{
  "info": {
    "_postman_id": "617d550d-03d7-4d68-b037-57939ff6546c",
    "name": "DCO-2-GET-(post checks)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "44390588"
  },
  "item": [
    {
      "name": "DocumentsView",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is a non-empty array\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.be.an(\"array\");\r",
              "    pm.expect(json.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Expected documents with categories are visible\", function () {\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    const expectedDocuments = [\r",
              "        { name: \"AddressDocumentPostman\", category: \"AddressPostman (random mark)\" },\r",
              "        { name: \"PersonDocumentPostman\", category: \"PersonPostman\" },\r",
              "        { name: \"BirthDocumentPostman\", category: \"BirthPostman\" },\r",
              "        { name: \"MarriageDocumentPostman\", category: \"MarriagePostman\" },\r",
              "        { name: \"DeathDocumentPostman\", category: \"DeathPostman\" },\r",
              "        { name: \"NameToDeletePostman\", category: \"CategoryToDeletePostman\" }\r",
              "    ];\r",
              "\r",
              "    expectedDocuments.forEach(doc => {\r",
              "        const found = json.some(item =>\r",
              "            item.name === doc.name &&\r",
              "            item.category === doc.category\r",
              "        );\r",
              "\r",
              "        pm.expect(found, `Missing document: ${doc.name} / ${doc.category}`).to.eql(true);\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is below 200\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5159/api/Document",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5159",
          "path": [
            "api",
            "Document"
          ]
        }
      },
      "response": []
    }
  ]
}